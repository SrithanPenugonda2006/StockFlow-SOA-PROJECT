# OmniStock Environment Variables Example
# Copy this file to .env and fill in the real values
# NEVER commit .env to git!

# JWT Configuration
JWT_SECRET=omnistock-super-secret-key-must-be-at-least-256-bits-long-for-hmacsha256

# Database Configuration (for running services individually, not via docker-compose)
# auth-service
AUTH_DB_URL=jdbc:postgresql://localhost:5432/omnistock_auth
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=your_password_here

# product-service
PRODUCT_DB_URL=jdbc:postgresql://localhost:5433/omnistock_product
PRODUCT_DB_USERNAME=postgres
PRODUCT_DB_PASSWORD=your_password_here

# inventory-service
INVENTORY_DB_URL=jdbc:postgresql://localhost:5434/omnistock_inventory
INVENTORY_DB_USERNAME=postgres
INVENTORY_DB_PASSWORD=your_password_here

# order-service
ORDER_DB_URL=jdbc:postgresql://localhost:5435/omnistock_order
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=your_password_here

# Eureka
EUREKA_URI=http://localhost:8761/eureka

# Low Stock Threshold
LOW_STOCK_THRESHOLD=10

# Mail Configuration (Gmail SMTP)
# To send actual emails to your inbox, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password

