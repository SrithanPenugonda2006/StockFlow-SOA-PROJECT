# =================================================================
# StockFlow (OmniStock) - System Environment Variables Example
# =================================================================
# Copy this file to .env at the root or within subfolders as needed.
# NEVER commit .env files containing real credentials to version control!

# -----------------------------------------------------------------
# Security & JWT
# -----------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long

# -----------------------------------------------------------------
# Mail Configuration (SMTP)
# -----------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# -----------------------------------------------------------------
# Application Ports & Routing
# -----------------------------------------------------------------
EUREKA_URI=http://localhost:8761/eureka
AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
FRONTEND_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------
# Database Credentials (PostgreSQL / Local)
# -----------------------------------------------------------------
AUTH_DB_URL=jdbc:postgresql://localhost:5432/omnistock_auth
AUTH_DB_USERNAME=your_username
AUTH_DB_PASSWORD=your_password

PRODUCT_DB_URL=jdbc:postgresql://localhost:5433/omnistock_product
PRODUCT_DB_USERNAME=your_username
PRODUCT_DB_PASSWORD=your_password

INVENTORY_DB_URL=jdbc:postgresql://localhost:5434/omnistock_inventory
INVENTORY_DB_USERNAME=your_username
INVENTORY_DB_PASSWORD=your_password

ORDER_DB_URL=jdbc:postgresql://localhost:5435/omnistock_order
ORDER_DB_USERNAME=your_username
ORDER_DB_PASSWORD=your_password
